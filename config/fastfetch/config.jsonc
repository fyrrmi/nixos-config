{
  "logo": {
    "type": "auto",
    "source": "NixOS2",
    "padding": { "top": 1, "left": 2 },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    "break",
    { "type": "kernel", "key": " kernel" },
    { "type": "os", "key": " distro" },
    { "type": "cpu", "key": " cpu" },
    { "type": "gpu", "key": " gpu" },
    { "type": "wm", "key": " wm" },
    { "type": "shell", "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "memory", "key": " memory" },
    { "type": "uptime", "key": " uptime" },
    "break",
    { "type": "colors", "symbol": "block", "block": { "range": [0, 7] } },
  ],
}
